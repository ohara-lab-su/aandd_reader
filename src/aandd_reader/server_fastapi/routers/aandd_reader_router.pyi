from typing import Optional, Any
from aandd_reader.server_fastapi.models.comman import ResultResponse
from x_logger.x_logger import XLogger
from fastapi import APIRouter
class AanddReaderRouter:
    """
    FastAPI Router動的生成用ベースクラス
    api_specの内容に応じて動的にhandler/routeを生やす
    """

    def __init__(self, device_instance, api_spec, logger: Optional[XLogger] = None): ...
    def __getattr__(self, name) -> Any: ...
    def __setattr__(self, name, value): ...
    @staticmethod
    def _ok(result: object) -> object: ...
    @staticmethod
    def _bad_request(msg: str) -> object: ...
    def _make_handler(self, api): ...
    _logger: XLogger
    router: APIRouter
    # get_status() 
    async def get_status(self) -> Any: ...
    # get_unit() 
    async def get_unit(self) -> Any: ...
    # get_serial_number
    async def get_serial_number(self) -> Any: ...
    # cal() キャリブレーション
    async def cal(self) -> Any: ...
    # measure_single 計測(status,unit)
    async def meas(self) -> Any: ...