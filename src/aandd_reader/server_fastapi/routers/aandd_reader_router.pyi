from typing import Optional, Any, Dict, overload
from aandd_reader.server_fastapi.models.comman import SetMeasModeRequest, StreamStartRequest, WaitEventRequest, WatchStartRequest, WatchStopRequest
from fastapi import APIRouter
class AanddReaderRouter:
    """
    FastAPI Router動的生成用ベースクラス
    api_specの内容に応じて動的にhandler/routeを生やす
    """

    def __init__(self, device_instance, api_spec, logger: Optional[Any] = None, log_level: str = 'INFO'): ...
    def _extract_args_kwargs(self, api, request, target_func=None): ...
    def _dispatch_api(self, api, request): ...
    def _get_api_spec(self, method_name: str): ...
    def _make_handler(self, api): ...
    async def _dispatch_handler(self, request: dict): ...
    _logger: Any
    router: APIRouter
    # get_status() 
    async def get_status(self) -> Any: ...
    # get_unit() 
    async def get_unit(self) -> Any: ...
    # get_serial_number
    async def get_serial_number(self) -> Any: ...
    # reset zero-reset
    async def reset(self) -> Any: ...
    # measure_single 計測(status,unit)
    async def meas(self) -> Any: ...
    # get_meas_mode measのモードを取得
    async def get_meas_mode(self) -> Any: ...
    # set_meas_mode measのモードを設定 (Q/S)
    async def set_meas_mode(self, request: Optional[SetMeasModeRequest] = None) -> Any: ...
    # start_stream バックグラウンドでストリーム計測開始
    async def stream_start(self, request: Optional[StreamStartRequest] = None) -> Any: ...
    # stop_stream ストリーム計測停止
    async def stream_stop(self) -> Any: ...
    # watch_start watch を開始（threshold/hysteresis）
    async def watch_start(self, request: Optional[WatchStartRequest] = None) -> Any: ...
    # watch_stop watch を停止
    async def watch_stop(self, request: Optional[WatchStopRequest] = None) -> Any: ...
    # wait_event watch のイベントを long-poll で待つ
    async def wait_event(self, request: Optional[WaitEventRequest] = None) -> Any: ...