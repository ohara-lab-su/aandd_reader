from typing import Any, Optional

class AanddReaderGrpcClient:
    def __init__(self, config: Any = ..., server_ip: Optional[str] = ..., server_port: Optional[int] = ..., logger: Any = ..., log_level: str = ..., timeout_sec: Optional[float] = ...) -> None: ...
    def status(self) -> Any: ...
    def get_status(self) -> Optional[str]: ...
    def unit(self) -> Any: ...
    def get_unit(self) -> Optional[str]: ...
    def get_weight(self) -> Optional[float]: ...
    def is_ack(self, data: bytes) -> bool: ...
    def get_serial_number(self) -> Any: ...
    def set_meas_mode(self, val: str = ...) -> Any: ...
    def get_meas_mode(self) -> str: ...
    def reset(self) -> Any: ...
    def meas(self, mode: Optional[str] = ...) -> Any: ...