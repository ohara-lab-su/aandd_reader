from typing import Any, Optional, Union, Dict, List, Tuple, Callable, Sequence

class AanddReaderGrpcClient:
    def __init__(self, config: Optional[Any] = ..., server_ip: Optional[str] = ..., server_port: Optional[int] = ..., timeout_sec: Optional[float] = ..., logger: Optional[Any] = ..., log_level: Optional[str] = ...) -> None: ...
    def prepare_event_measurement(self, *, topic: str, threshold_g: float, above: bool = ..., once: bool = ..., trigger_mode: str = ..., trigger_window: int = ..., trigger_min_samples: Optional[int] = ..., trigger_alpha: float = ..., trigger_stable_only: bool = ...) -> None: ...
    def wait_event(self) -> Any: ...
    def wait_for_ready(self, timeout_sec: float = ...) -> bool: ...
    def is_connected(self) -> bool: ...
    def close(self) -> None: ...
    def subscribe(self, *, topic: str, once: bool = ..., source: str = ...) -> Any: ...
    def status(self) -> Optional[str]: ...
    def get_status(self) -> Optional[str]: ...
    def unit(self) -> Optional[str]: ...
    def get_unit(self) -> Optional[str]: ...
    def get_weight(self) -> Optional[float]: ...
    def is_ack(self, data: bytes) -> bool: ...
    def get_serial_number(self) -> Any: ...
    def set_meas_mode(self, val: str = ...) -> Any: ...
    def get_meas_mode(self) -> str: ...
    def reset(self) -> Union[bool, str]: ...
    def meas(self, mode: Optional[str] = ...) -> Union[bool, float, str, None]: ...
    def event_set_config(self, *, topic: str, threshold_g: float, above: bool = ...) -> bool: ...
    def event_arm(self, *, once: bool = ...) -> bool: ...
    def event_disarm(self) -> bool: ...
    def set_trigger_mode(self, *, mode: str = ..., window: int = ..., min_samples: Optional[int] = ..., alpha: float = ..., stable_only: bool = ...) -> None: ...
    def stream_start(self) -> bool: ...
    def stream_stop(self) -> bool: ...